# MeasureMate web app (Next.js). Build from the repository root:
#   docker build -f infrastructure/docker/Dockerfile.web --build-arg API_URL=http://api:4000 -t measuremate-web .
# API_URL is baked into the Next.js rewrite rules at build time.
FROM node:22-bookworm-slim AS build
ARG API_URL=http://api:4000
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true API_URL=$API_URL NEXT_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app
# The whole workspace is copied (see .dockerignore) so the frozen lockfile matches every workspace package.
COPY . .
RUN pnpm install --frozen-lockfile --filter @measuremate/web...
RUN pnpm --filter @measuremate/validation build \
 && pnpm --filter @measuremate/web build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production PORT=3100 NEXT_TELEMETRY_DISABLED=1
RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build --chown=node:node /app /app
USER node
WORKDIR /app/apps/web
EXPOSE 3100
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD wget -qO- http://127.0.0.1:3100/login >/dev/null || exit 1
CMD ["node", "node_modules/next/dist/bin/next", "start", "-p", "3100"]
