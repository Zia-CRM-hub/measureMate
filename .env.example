# Copy to .env and fill in. NEVER commit the real .env file.
# Generate strong values with: sh scripts/gen-secrets.sh

# ---- Public address ---------------------------------------------------------
# Host name users type in the browser. Use "localhost" to try the stack on your own machine.
DOMAIN=localhost

# ---- Database ---------------------------------------------------------------
DB_NAME=measuremate
# Use letters and digits only in database passwords (they are placed inside connection URLs).
# Owner account: used ONLY to run migrations and backups.
DB_OWNER_USER=measuremate_owner
DB_OWNER_PASSWORD=
# Restricted application account (role "mm_app"): used by the API at runtime.
# Row-Level Security tenant isolation depends on the API NOT using the owner account.
DB_APP_PASSWORD=

# ---- API --------------------------------------------------------------------
# Signs session tokens. 32+ random characters. Changing it signs everyone out.
SESSION_SECRET=
SESSION_TTL_HOURS=12

# First super admin, created at start-up only if the account does not exist yet.
# Password must be at least 12 characters. Remove these after first start if you prefer.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Days between a business asking to be deleted and permanent deletion being allowed.
TENANT_DELETION_GRACE_DAYS=14

# ---- Email (optional) -------------------------------------------------------
# Leave SMTP_HOST empty to run without email; invitation links are then shown on screen.
SMTP_HOST=
SMTP_PORT=587
MAIL_FROM="MeasureMate <no-reply@example.com>"

# ---- Backups (used by scripts/backup.sh) ------------------------------------
# Encrypts backup files. Store this somewhere safe and separate: without it backups cannot be restored.
BACKUP_PASSPHRASE=
BACKUP_DIR=./backups
# Optional: copy backups off the server with rclone (e.g. "myremote:measuremate-backups").
RCLONE_REMOTE=
